# NexusPay AI Environment Configuration
# Note: Zero-setup demo mode works out-of-the-box without keys!
PORT=3000

# PayPal Developer Sandbox Credentials (Optional - Default Sandbox Mock included)
# Get yours at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=test
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Gemini / AI API Key (Optional - Fallback rule-based AI verification engine included)
GEMINI_API_KEY=
