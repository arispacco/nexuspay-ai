# NexusPay AI configuration. Everything is optional: with no keys the app runs in simulated mode.
PORT=3000

# Real PayPal sandbox (developer.paypal.com -> Apps & Credentials -> Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Gemini for contract drafting and code review (Google AI Studio). Without it a rule-based analyser is used.
GEMINI_API_KEY=

# Shared secret that signs and verifies confidential test reports (set the same value where you run `npm run attest`)
NEXUSPAY_ATTESTATION_SECRET=
